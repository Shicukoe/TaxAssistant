# Copy file này thành .env rồi điền giá trị thật. .env KHÔNG được commit.

# --- PostgreSQL ---
PGHOST=127.0.0.1
PGPORT=5432
# User riêng của app — tạo bằng app/db/create_app_user.sql.
# PGPASSWORD là mật khẩu đã đặt cho taxassistant khi chạy script đó. Mật khẩu có dấu cách
# hoặc ký tự # thì bọc trong nháy đơn: PGPASSWORD='...'
# Đừng viết chú thích cùng dòng với giá trị rỗng — dotenv sẽ lấy chú thích làm giá trị.
PGUSER=taxassistant
PGPASSWORD=
PGDATABASE=taxassistant

# --- Model tự host (llama-server, khởi động bằng scripts/run_model_server.sh) ---
LLM_BASE_URL=http://127.0.0.1:9931/v1
LLM_MODEL=qwen3.5-4b
# Thông số lấy mẫu — lý do và nguồn: docs/danh-gia.md
LLM_ANSWER_TEMPERATURE=0.4
LLM_CLASSIFY_TEMPERATURE=0
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_SEED=42
LLM_ANSWER_MAX_TOKENS=1500
# Guardrail g (câu kết luận phải được căn cứ ủng hộ) — model NLI chạy CPU; ngưỡng hiệu chỉnh trên tập kiểm định
NLI_MODEL=MoritzLaurer/mDeBERTa-v3-base-xnli-multilingual-nli-2mil7
NLI_ONNX_DIR=D:/models/nli-onnx/mdeberta-fp32   # bản ONNX của NLI_MODEL — bash scripts/convert_nli_to_onnx.sh
NLI_SUPPORT_THRESHOLD=0.5
NLI_WARNINGS_VISIBLE=false     # chế độ đo: chấm và lưu điểm, chưa hiện cảnh báo — bật sau khi hiệu chỉnh ngưỡng
HF_HUB_DISABLE_SYMLINKS_WARNING=1   # Windows không bật symlink → cache HF vẫn chạy, chỉ tốn chỗ hơn
# Giới hạn kiểu dữ liệu khi đọc lại checkpoint LangGraph (cảnh báo bảo mật trong README của checkpointer)
LANGGRAPH_STRICT_MSGPACK=true


# --- Thu thập dữ liệu ---
# vbpl.vn chặn (403) User-Agent mặc định của curl → dùng UA kiểu trình duyệt
FETCH_USER_AGENT=Mozilla/5.0
FETCH_DELAY_SECONDS=2             # gọi chậm, có nhịp
RAW_DATA_DIR=./data/raw           # nơi lưu bản gốc — luôn lưu trước khi xử lý
CONVERTED_DATA_DIR=./data/converted   # XHTML Tika đọc từ file đính kèm — tạo lại được
JAVA_EXE=D:/tools/java/jdk-21.0.12.1+1-jre/bin/java.exe   # Java 17+ cho Tika
TIKA_APP_JAR=D:/tools/tika/tika-app-4.1.0.jar

# Web app (app/web) — nghe 127.0.0.1; máy khác vào qua tailscale serve (HTTPS)
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Địa chỉ HTTPS mà tailscale serve in ra, không có dấu / cuối — dùng để chống CSRF
WEB_PUBLIC_ORIGIN=https://ten-may.ten-tailnet.ts.net

# --- Đăng nhập (docs/architecture.md, Truy cập và phân quyền) ---
# Khoá HMAC cho mã OTP — sinh một lần: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=
# Gmail gửi mã OTP: tài khoản bật xác minh 2 bước, tạo App Password ở myaccount.google.com/apppasswords
# (Google thu hồi App Password khi đổi mật khẩu tài khoản → tạo lại)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Embedding BGE-M3 — llama-server thứ hai (bash scripts/run_embedding_server.sh)
EMBEDDING_BASE_URL=http://127.0.0.1:9932/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_VERSION=f16-b11796-ctx1
