# Copy file này thành .env rồi điền giá trị thật. .env KHÔNG được commit.

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=tro_ly_thue

# --- Claude API ---
# Chưa cần cho tới bước "Trả lời".
ANTHROPIC_API_KEY=

# --- Giới hạn chi phí ---
BUDGET_MONTHLY_VND=300000
BUDGET_USD_PER_VND=0.0000385      # tỷ giá quy đổi — cần kiểm và cập nhật định kỳ
QUOTA_QUESTIONS_PER_5H=10

# --- Thu thập dữ liệu ---
# vbpl.vn chặn (403) User-Agent mặc định của curl → dùng UA kiểu trình duyệt
FETCH_USER_AGENT=Mozilla/5.0
FETCH_DELAY_SECONDS=2             # gọi chậm, có nhịp
RAW_STORE_PATH=./data/raw         # nơi lưu bản gốc — luôn lưu trước khi xử lý
